  @@index([actorId], map: "idx_audit_logs_actor")
  @@index([entity], map: "idx_audit_logs_entity")
  @@index([entityId], map: "idx_audit_logs_entity_id")
  @@index([action], map: "idx_audit_logs_action")
  @@index([createdAt], map: "idx_audit_logs_created")
  @@map("audit_logs")
}


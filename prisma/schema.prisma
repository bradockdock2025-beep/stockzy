// Regra de exibição condicional da faceta (buildingConcept/BACKEND-ENDPOINT-CATALOG-FILTERS.md,
// tabela facet_rules). "always" cobre Category/Brands/Activity/Color/Price. category_family
// cobre Shoe Height (visibilityValue = tag da Category, ex. "calcado"). gender_fixed_absent
// cobre Gender (some quando já fixo na query). gender_equals cobre Age Group
// (visibilityValue = "kids"). Facetas cuja contagem zera após auto-exclusão continuam somendo
// dinamicamente na resposta independente dessa regra — isso é lógica de aplicação, não dado.
enum facet_visibility {
  always
  category_family
  gender_fixed_absent
  gender_equals
}


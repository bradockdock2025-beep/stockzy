generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         user_role @default(admin)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  refreshTokens RefreshToken[]

  @@map("users")
}

model Customer {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authUserId         String?          @unique @map("auth_user_id") @db.Uuid
  firstName          String?          @map("first_name")
  lastName           String?          @map("last_name")
  email              String           @unique
  passwordHash       String?          @map("password_hash")
  phoneNumber        String?          @map("phone_number")
  emailVerifiedAt    DateTime?        @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt    DateTime?        @map("phone_verified_at") @db.Timestamptz(6)
  mfaEnabled         Boolean          @default(false) @map("mfa_enabled")
  mfaMethod          String?          @map("mfa_method")
  termsAcceptedAt    DateTime?        @map("terms_accepted_at") @db.Timestamptz(6)
  privacyAcceptedAt  DateTime?        @map("privacy_accepted_at") @db.Timestamptz(6)
  marketingConsent   Boolean          @default(false) @map("marketing_consent")
  marketingConsentAt DateTime?        @map("marketing_consent_at") @db.Timestamptz(6)
  isActive           Boolean          @default(true) @map("is_active")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  addresses          Address[]
  carts              Cart[]
  orders             Order[]
  consents           CustomerConsent[]
  promotionUsages    PromotionUsage[]
  productViews       ProductView[]
  wishlist           Wishlist?
  offers             Offer[]

  @@index([phoneNumber], map: "idx_customers_phone")
  @@map("customers")
}

model CustomerConsent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String  @map("customer_id") @db.Uuid
  type      String
  version   String?
  granted   Boolean  @default(true)
  source    String?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([customerId, type, createdAt], map: "idx_customer_consents_customer_type_created")
  @@map("customer_consents")
}

model Category {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  slug       String              @unique
  code       String?             @map("code")
  familyTag  String?             @map("family_tag")
  bannerTitle       String?      @map("banner_title")
  bannerDescription String?      @map("banner_description")
  isActive   Boolean             @default(true) @map("is_active")
  parentId   String?             @map("parent_id") @db.Uuid
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  parent     Category?           @relation("CategoryHierarchy", fields: [parentId], references: [id], onUpdate: NoAction)
  children   Category[]          @relation("CategoryHierarchy")
  products   Product[]
  promotionTargets PromotionTarget[]

  @@index([isActive], map: "idx_categories_active")
  @@index([parentId], map: "idx_categories_parent")
  @@index([familyTag], map: "idx_categories_family_tag")
  @@map("categories")
}

model SkuSequence {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope      String   @unique
  lastNumber Int      @map("last_number")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("sku_sequences")
}

model Product {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId     String           @map("category_id") @db.Uuid
  brandId        String?          @map("brand_id") @db.Uuid
  name           String
  slug           String           @unique
  description    String?
  status         product_status   @default(draft)
  featured       Boolean          @default(false)
  featuredUntil  DateTime?        @map("featured_until") @db.Timestamptz(6)
  featuredOrder  Int?             @map("featured_order")
  displayOrder   Int?             @map("display_order")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  images         ProductImage[]
  variants       ProductVariant[]
  promotionTargets PromotionTarget[]
  ranking        ProductRanking?
  category       Category         @relation(fields: [categoryId], references: [id], onUpdate: NoAction)
  brand          Brand?           @relation(fields: [brandId], references: [id], onUpdate: NoAction)
  views          ProductView[]
  coOccurrencesA ProductCoOccurrence[] @relation("CoOccurrenceA")
  coOccurrencesB ProductCoOccurrence[] @relation("CoOccurrenceB")
  wishlistItems  WishlistItem[]
  facetValues    ProductFacetValue[]

  @@index([categoryId], map: "idx_products_category")
  @@index([brandId], map: "idx_products_brand")
  @@index([featured], map: "idx_products_featured")
  @@index([status], map: "idx_products_status")
  @@index([featuredUntil], map: "idx_products_featured_until")
  @@map("products")
}

model ProductRanking {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId    String   @unique @map("product_id") @db.Uuid
  unitsSold7d  Int      @default(0) @map("units_sold_7d")
  unitsSold30d Int      @default(0) @map("units_sold_30d")
  unitsSoldAll Int      @default(0) @map("units_sold_all")
  score        Decimal  @default(0) @db.Decimal(12, 4)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([score(sort: Desc)], map: "idx_product_rankings_score")
  @@map("product_rankings")
}

model ProductVariant {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String                  @map("product_id") @db.Uuid
  sku            String                  @unique
  title          String?
  price          Decimal                 @db.Decimal(12, 2)
  compareAtPrice Decimal?                @map("compare_at_price") @db.Decimal(12, 2)
  weightKg       Decimal?                @map("weight_kg") @db.Decimal(10, 3)
  heightCm       Decimal?                @map("height_cm") @db.Decimal(10, 2)
  widthCm        Decimal?                @map("width_cm") @db.Decimal(10, 2)
  depthCm        Decimal?                @map("depth_cm") @db.Decimal(10, 2)
  isActive            Boolean                 @default(true) @map("is_active")
  presaleEnabled      Boolean                 @default(false) @map("presale_enabled")
  presalePrice        Decimal?                @map("presale_price") @db.Decimal(12, 2)
  presaleLimit        Int?                    @map("presale_limit")
  expectedAvailableAt DateTime?               @map("expected_available_at") @db.Timestamptz(6)
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  cartItems      CartItem[]
  inventory      Inventory?
  orderItems     OrderItem[]
  images         ProductImage[]
  priceHistory   PriceHistory[]
  product        Product                 @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  facetValues    VariantFacetValue[]
  offers         Offer[]

  @@index([isActive], map: "idx_variants_active")
  @@index([productId], map: "idx_variants_product")
  @@map("product_variants")
}

model PriceHistory {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId      String         @map("variant_id") @db.Uuid
  price          Decimal        @db.Decimal(12, 2)
  compareAtPrice Decimal?       @map("compare_at_price") @db.Decimal(12, 2)
  actorId        String?        @map("actor_id") @db.Uuid
  actorEmail     String?        @map("actor_email")
  actorRole      String?        @map("actor_role")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([variantId, createdAt], map: "idx_price_history_variant_created")
  @@map("price_history")
}

model Inventory {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId        String         @unique @map("variant_id") @db.Uuid
  stockQuantity    Int            @default(0) @map("stock_quantity")
  reservedQuantity Int            @default(0) @map("reserved_quantity")
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("inventory")
}

model ProductImage {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String          @map("product_id") @db.Uuid
  variantId String?         @map("variant_id") @db.Uuid
  url       String
  altText   String?         @map("alt_text")
  position  Int             @default(0)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([productId], map: "idx_images_product")
  @@index([variantId], map: "idx_images_variant")
  @@map("product_images")
}

// --- Catálogo facetado (buildingConcept/) ---
// Modelo aditivo: convive com CategoryAttribute/AttributeOption/VariantAttributeValue,
// que continuam em uso. Migração de dados existentes é etapa separada, não incluída aqui.

model Brand {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String    @unique
  logoUrl   String?   @map("logo_url")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  products  Product[]

  @@index([isActive], map: "idx_brands_active")
  @@map("brands")
}

model Facet {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key             String            @unique
  name            String
  inputType       facet_input_type  @map("input_type")
  scope           facet_scope       @default(product)
  visibility      facet_visibility  @default(always)
  visibilityValue String?           @map("visibility_value")
  sortOrder       Int?              @map("sort_order")
  isActive        Boolean           @default(true) @map("is_active")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  values          FacetValue[]

  @@map("facets")
}

model FacetValue {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facetId      String              @map("facet_id") @db.Uuid
  value        String
  label        String
  extra        Json?
  sortOrder    Int?                @map("sort_order")
  bannerTitle       String?        @map("banner_title")
  bannerDescription String?        @map("banner_description")
  isActive     Boolean             @default(true) @map("is_active")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  facet        Facet               @relation(fields: [facetId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  productLinks ProductFacetValue[]
  variantLinks VariantFacetValue[]

  @@unique([facetId, value])
  @@index([facetId], map: "idx_facet_values_facet")
  @@map("facet_values")
}

model ProductFacetValue {
  productId    String     @map("product_id") @db.Uuid
  facetValueId String     @map("facet_value_id") @db.Uuid
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  facetValue   FacetValue @relation(fields: [facetValueId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([productId, facetValueId])
  @@index([facetValueId], map: "idx_product_facet_values_value")
  @@map("product_facet_values")
}

model VariantFacetValue {
  variantId    String         @map("variant_id") @db.Uuid
  facetValueId String         @map("facet_value_id") @db.Uuid
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  facetValue   FacetValue     @relation(fields: [facetValueId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([variantId, facetValueId])
  @@index([facetValueId], map: "idx_variant_facet_values_value")
  @@map("variant_facet_values")
}

model Cart {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId   String?    @map("customer_id") @db.Uuid
  sessionToken String?    @unique @map("session_token")
  status       String     @default("active")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  items        CartItem[]
  customer     Customer?  @relation(fields: [customerId], references: [id], onUpdate: NoAction)

  @@index([customerId], map: "idx_carts_customer")
  @@map("carts")
}

model CartItem {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId    String         @map("cart_id") @db.Uuid
  variantId String         @map("variant_id") @db.Uuid
  quantity  Int            @default(1)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onUpdate: NoAction)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model Order {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId      String?      @map("customer_id") @db.Uuid
  orderNumber     String       @unique @map("order_number")
  status          order_status @default(pending)
  subtotal        Decimal      @db.Decimal(12, 2)
  shippingAmount  Decimal      @default(0) @map("shipping_amount") @db.Decimal(12, 2)
  discountAmount  Decimal      @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount     Decimal      @map("total_amount") @db.Decimal(12, 2)
  shippingAddress Json         @map("shipping_address")
  billingAddress  Json?        @map("billing_address")
  locale          String       @default("pt") @map("locale")
  guestPhone      String?      @map("guest_phone")
  guestToken      String?      @unique @map("guest_token")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  items           OrderItem[]
  customer        Customer?    @relation(fields: [customerId], references: [id], onUpdate: NoAction)
  payment         Payment?
  promotionUsages PromotionUsage[]
  shipments       Shipment[]
  offer           Offer?

  @@index([createdAt], map: "idx_orders_created")
  @@index([customerId], map: "idx_orders_customer")
  @@index([status], map: "idx_orders_status")
  @@map("orders")
}

model Payment {
  id                        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId                   String         @unique @map("order_id") @db.Uuid
  method                    payment_method
  status                    payment_status
  amount                    Decimal        @db.Decimal(12, 2)
  currency                  String
  confirmationCodeHash      String?        @map("confirmation_code_hash")
  confirmationCodeExpiresAt DateTime?      @map("confirmation_code_expires_at") @db.Timestamptz(6)
  confirmationAttempts      Int            @default(0) @map("confirmation_attempts")
  confirmedAt               DateTime?      @map("confirmed_at") @db.Timestamptz(6)
  confirmedBy               String?        @map("confirmed_by") @db.Uuid
  metadata                  Json?
  createdAt                 DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  order                     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status], map: "idx_payments_status")
  @@index([orderId], map: "idx_payments_order")
  @@map("payments")
}

model OrderItem {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String         @map("order_id") @db.Uuid
  variantId   String         @map("variant_id") @db.Uuid
  productName String         @map("product_name")
  sku         String
  quantity    Int
  unitPrice   Decimal        @map("unit_price") @db.Decimal(12, 2)
  totalPrice  Decimal        @map("total_price") @db.Decimal(12, 2)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("order_items")
}

// --- Make Offer (negociação de preço, ver PLANO_MAKE_OFFER.md) ---
// Fase 1: sem auto-aceite (minOfferPercent) e sem motor de concorrência/janela
// (§4.1 do plano) — toda oferta nasce "pending" e é decidida manualmente pelo
// admin. windowClosesAt fica reservado pra quando a Fase 2 (auto-aceite +
// disputa por escassez) for implementada.
model Offer {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId       String       @map("variant_id") @db.Uuid
  customerId      String?      @map("customer_id") @db.Uuid
  guestEmail      String?      @map("guest_email")
  guestToken      String?      @unique @map("guest_token")
  listedPrice     Decimal      @map("listed_price") @db.Decimal(12, 2)
  offeredPrice    Decimal      @map("offered_price") @db.Decimal(12, 2)
  locale          String       @default("pt")
  status          offer_status @default(pending)
  windowClosesAt  DateTime?    @map("window_closes_at") @db.Timestamptz(6)
  rejectionReason String?      @map("rejection_reason")
  expiresAt       DateTime     @map("expires_at") @db.Timestamptz(6)
  respondedAt     DateTime?    @map("responded_at") @db.Timestamptz(6)
  respondedBy     String?      @map("responded_by") @db.Uuid
  orderId         String?      @unique @map("order_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customer        Customer?      @relation(fields: [customerId], references: [id], onUpdate: NoAction)
  order           Order?         @relation(fields: [orderId], references: [id], onUpdate: NoAction)

  @@index([variantId], map: "idx_offers_variant")
  @@index([status], map: "idx_offers_status")
  @@map("offers")
}

model Shipment {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId             String           @map("order_id") @db.Uuid
  status              shipment_status  @default(pending)
  carrier             String?
  trackingNumber      String?          @map("tracking_number")
  trackingUrl         String?          @map("tracking_url")
  serviceLevel        String?          @map("service_level")
  shippedAt           DateTime?        @map("shipped_at") @db.Timestamptz(6)
  deliveredAt         DateTime?        @map("delivered_at") @db.Timestamptz(6)
  estimatedDeliveryAt DateTime?        @map("estimated_delivery_at") @db.Timestamptz(6)
  metadata            Json?
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  order               Order            @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  events              ShipmentEvent[]

  @@index([orderId], map: "idx_shipments_order")
  @@index([status], map: "idx_shipments_status")
  @@index([trackingNumber], map: "idx_shipments_tracking")
  @@map("shipments")
}

model ShipmentEvent {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipmentId String          @map("shipment_id") @db.Uuid
  status     shipment_status
  message    String?
  location   String?
  occurredAt DateTime        @default(now()) @map("occurred_at") @db.Timestamptz(6)
  metadata   Json?
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  shipment   Shipment        @relation(fields: [shipmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([shipmentId], map: "idx_shipment_events_shipment")
  @@index([status], map: "idx_shipment_events_status")
  @@index([occurredAt], map: "idx_shipment_events_occurred")
  @@map("shipment_events")
}

model Address {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String       @map("customer_id") @db.Uuid
  type       address_type
  street     String
  city       String
  state      String?
  zipcode    String?
  country    String
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([customerId], map: "idx_addresses_customer")
  @@map("addresses")
}

model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_refresh_tokens_user")
  @@index([expiresAt], map: "idx_refresh_tokens_expires")
  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  actorEmail String? @map("actor_email")
  actorRole String?  @map("actor_role")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  before    Json?    @map("before_state")
  after     Json?    @map("after_state")

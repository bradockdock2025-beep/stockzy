model Promotion {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  code              String?            @unique
  type              promotion_type
  value             Decimal            @db.Decimal(12, 2)
  isActive          Boolean            @default(true) @map("is_active")
  startsAt          DateTime?          @map("starts_at") @db.Timestamptz(6)
  endsAt            DateTime?          @map("ends_at") @db.Timestamptz(6)
  priority          Int                @default(0)
  minSubtotal       Decimal?           @map("min_subtotal") @db.Decimal(12, 2)
  maxUses           Int?               @map("max_uses")
  maxUsesPerCustomer Int?              @map("max_uses_per_customer")
  label             String?
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  targets           PromotionTarget[]
  usages            PromotionUsage[]

  @@index([isActive], map: "idx_promotions_active")
  @@index([startsAt, endsAt], map: "idx_promotions_window")
  @@index([label], map: "idx_promotions_label")
  @@map("promotions")
}

model PromotionTarget {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

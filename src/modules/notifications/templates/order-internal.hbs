<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Nova Venda</title>
</head>
<body style="margin:0;padding:0;background:#f5f5f5;font-family:Arial,Helvetica,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background:#f5f5f5;padding:40px 0;">
    <tr><td align="center">
      <table width="600" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:8px;overflow:hidden;max-width:600px;width:100%;">

        <!-- Header -->
        <tr>
          <td style="background:#000000;padding:24px 40px;text-align:center;">
            <img src="https://lpowjerychcsqrtodvoh.supabase.co/storage/v1/object/public/email-assets/logo.png" alt="Stockzy" width="160" style="display:block;margin:0 auto;max-width:160px;" />
          </td>
        </tr>

        <!-- Badge -->
        <tr>
          <td style="padding:32px 40px 0 40px;text-align:center;">
            {{#if isGuest}}
            <div style="display:inline-block;background:#e3f2fd;border-radius:50px;padding:8px 20px;border:1px solid #1976d2;">
              <p style="margin:0;color:#1565c0;font-size:13px;font-weight:bold;">🛒 Nova venda — Guest (sem conta)</p>
            </div>
            {{else if isPresale}}
            <div style="display:inline-block;background:#fff8e1;border-radius:50px;padding:8px 20px;border:1px solid #f59e0b;">
              <p style="margin:0;color:#b45309;font-size:13px;font-weight:bold;">⏳ Nova pré-compra confirmada</p>
            </div>
            {{else}}
            <div style="display:inline-block;background:#e8f5e9;border-radius:50px;padding:8px 20px;">
              <p style="margin:0;color:#2e7d32;font-size:13px;font-weight:bold;">🛍 Nova venda confirmada</p>
            </div>
            {{/if}}
          </td>
        </tr>

        <!-- Body -->
        <tr>
          <td style="padding:24px 40px 0 40px;">

            <!-- Order + Customer info -->
            <div style="background:#f9f9f9;border-radius:6px;padding:20px;margin-bottom:20px;">
              <table width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="color:#999;font-size:11px;text-transform:uppercase;letter-spacing:1px;padding-bottom:4px;">Pedido</td>
                  <td style="color:#000;font-size:15px;font-weight:bold;text-align:right;">{{orderNumber}}</td>
                </tr>
                <tr>
                  <td style="color:#999;font-size:11px;text-transform:uppercase;letter-spacing:1px;padding-top:10px;">Cliente</td>
                  <td style="color:#333;font-size:14px;text-align:right;padding-top:10px;">{{customerName}}</td>
                </tr>
                <tr>
                  <td style="color:#999;font-size:11px;text-transform:uppercase;letter-spacing:1px;padding-top:8px;">Email</td>
                  <td style="color:#333;font-size:14px;text-align:right;padding-top:8px;">{{customerEmail}}</td>
                </tr>
                {{#if customerPhone}}
                <tr>
                  <td style="color:#999;font-size:11px;text-transform:uppercase;letter-spacing:1px;padding-top:8px;">Telefone</td>
                  <td style="color:#333;font-size:14px;text-align:right;padding-top:8px;">{{customerPhone}}</td>
                </tr>
                {{/if}}
                {{#if paymentMethod}}
                <tr>
                  <td style="color:#999;font-size:11px;text-transform:uppercase;letter-spacing:1px;padding-top:8px;">Pagamento</td>
                  <td style="color:#333;font-size:14px;text-align:right;padding-top:8px;">{{paymentMethod}}</td>
                </tr>
                {{/if}}
                <tr>
                  <td style="color:#999;font-size:11px;text-transform:uppercase;letter-spacing:1px;padding-top:12px;border-top:1px solid #eee;">Total</td>
                  <td style="color:#000;font-size:18px;font-weight:bold;text-align:right;padding-top:12px;border-top:1px solid #eee;">€ {{totalAmount}}</td>
                </tr>
              </table>
            </div>

            <!-- Shipping address -->
            <div style="background:#fff8e1;border-radius:6px;padding:20px;margin-bottom:20px;border-left:4px solid #f59e0b;">
              <p style="margin:0 0 8px 0;color:#999;font-size:11px;text-transform:uppercase;letter-spacing:1px;">Endereço de Entrega</p>
              <p style="margin:0;color:#000;font-size:14px;line-height:1.6;">
                {{shippingStreet}}<br/>
                {{shippingCity}}{{#if shippingState}}, {{shippingState}}{{/if}}{{#if shippingZipcode}} — {{shippingZipcode}}{{/if}}<br/>
                {{shippingCountry}}
              </p>
            </div>

            {{#if isPresale}}
            <!-- Presale info -->
            <div style="background:#fff3cd;border-radius:6px;padding:20px;margin-bottom:20px;border-left:4px solid #f59e0b;">
              <p style="margin:0 0 4px 0;color:#999;font-size:11px;text-transform:uppercase;letter-spacing:1px;">Tipo de Pedido</p>
              <p style="margin:0 0 12px 0;color:#b45309;font-size:14px;font-weight:bold;">Pré-compra — pagamento já confirmado, aguarda stock</p>
              {{#if expectedAvailableAt}}
              <p style="margin:0 0 4px 0;color:#999;font-size:11px;text-transform:uppercase;letter-spacing:1px;">Disponível a partir de</p>
              <p style="margin:0;color:#000;font-size:15px;font-weight:bold;">{{expectedAvailableAt}}</p>
              {{/if}}
            </div>
            {{/if}}

            <!-- Items -->
            <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:20px;">
              <tr>
                <td style="padding:8px 0;border-bottom:2px solid #000;color:#000;font-size:11px;text-transform:uppercase;letter-spacing:1px;">Produto</td>
                <td style="padding:8px 0;border-bottom:2px solid #000;color:#999;font-size:11px;text-transform:uppercase;letter-spacing:1px;">SKU</td>
                <td style="padding:8px 0;border-bottom:2px solid #000;color:#000;font-size:11px;text-align:center;width:40px;">Qtd</td>
                <td style="padding:8px 0;border-bottom:2px solid #000;color:#000;font-size:11px;text-align:right;width:80px;">Valor</td>
              </tr>
              {{#each items}}
              <tr>
                <td style="padding:10px 0;border-bottom:1px solid #f0f0f0;color:#333;font-size:14px;">
                  {{this.productName}}
                  {{#if this.attributes}}
                  <br/><span style="color:#999;font-size:12px;">{{this.attributes}}</span>
                  {{/if}}
                </td>
                <td style="padding:10px 0;border-bottom:1px solid #f0f0f0;color:#999;font-size:12px;">{{this.sku}}</td>
                <td style="padding:10px 0;border-bottom:1px solid #f0f0f0;color:#333;font-size:14px;text-align:center;">{{this.quantity}}</td>
                <td style="padding:10px 0;border-bottom:1px solid #f0f0f0;color:#333;font-size:14px;text-align:right;">€ {{this.totalPrice}}</td>
              </tr>
              {{/each}}
              <tr>
                <td colspan="3" style="padding:8px 0;color:#666;font-size:13px;">Subtotal</td>
                <td style="padding:8px 0;color:#333;font-size:13px;text-align:right;">€ {{subtotal}}</td>
              </tr>
              <tr>
                <td colspan="3" style="padding:4px 0;color:#666;font-size:13px;">Frete</td>
                <td style="padding:4px 0;color:#333;font-size:13px;text-align:right;">€ {{shippingAmount}}</td>
              </tr>
              <tr>
                <td colspan="3" style="padding:10px 0;border-top:2px solid #000;color:#000;font-size:15px;font-weight:bold;">Total</td>
                <td style="padding:10px 0;border-top:2px solid #000;color:#000;font-size:15px;font-weight:bold;text-align:right;">€ {{totalAmount}}</td>
              </tr>
            </table>

          </td>
        </tr>

        <!-- Receipt button -->
        <tr>
          <td style="padding:0 40px 32px 40px;">
            <a href="{{receiptUrl}}" style="display:inline-block;background:#000;color:#fff;text-decoration:none;padding:12px 28px;border-radius:4px;font-size:13px;letter-spacing:2px;text-transform:uppercase;">Baixar Recibo PDF</a>
          </td>
        </tr>

        <!-- Footer -->
        <tr>
          <td style="background:#f9f9f9;padding:20px 40px;text-align:center;border-top:1px solid #eee;">
            <p style="color:#ccc;font-size:11px;margin:0;">Notificação interna — Stockzy © {{year}}</p>
          </td>
        </tr>

      </table>
    </td></tr>
  </table>
</body>
</html>

<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Nova Oferta</title>
</head>
<body style="margin:0;padding:0;background:#f5f5f5;font-family:Arial,Helvetica,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background:#f5f5f5;padding:40px 0;">
    <tr><td align="center">
      <table width="600" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:8px;overflow:hidden;max-width:600px;width:100%;">

        <tr>
          <td style="background:#000000;padding:24px 40px;text-align:center;">
            <img src="https://lpowjerychcsqrtodvoh.supabase.co/storage/v1/object/public/email-assets/logo.png" alt="Stockzy" width="160" style="display:block;margin:0 auto;max-width:160px;" />
          </td>
        </tr>

        <tr>
          <td style="padding:32px 40px 0 40px;text-align:center;">
            <div style="display:inline-block;background:#fff8e1;border-radius:50px;padding:8px 20px;border:1px solid #f59e0b;">
              <p style="margin:0;color:#b45309;font-size:13px;font-weight:bold;">💬 Nova oferta aguardando revisão</p>
            </div>
          </td>
        </tr>

        <tr>
          <td style="padding:24px 40px 0 40px;">
            <p style="color:#333;font-size:16px;margin:0 0 24px 0;">{{productName}} (SKU {{sku}})</p>

            <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:20px;">
              <tr>
                <td style="padding:8px 0;color:#666;font-size:13px;">Preço listado</td>
                <td style="padding:8px 0;color:#333;font-size:13px;text-align:right;">€ {{listedPrice}}</td>
              </tr>
              <tr>
                <td style="padding:8px 0;border-top:2px solid #000;color:#000;font-size:16px;font-weight:bold;">Oferta recebida</td>
                <td style="padding:8px 0;border-top:2px solid #000;color:#000;font-size:16px;font-weight:bold;text-align:right;">€ {{offeredPrice}} ({{percentOfListed}}%)</td>
              </tr>
            </table>

            <div style="background:#f9f9f9;border-radius:6px;padding:20px;margin-bottom:24px;">
              <p style="margin:0 0 4px 0;color:#999;font-size:11px;text-transform:uppercase;letter-spacing:2px;">{{#if isGuest}}Convidado{{else}}Cliente{{/if}}</p>
              <p style="margin:0 0 2px 0;color:#000;font-size:14px;">{{customerName}}</p>
              <p style="margin:0;color:#666;font-size:13px;">{{customerEmail}}</p>
            </div>

            <p style="color:#666;font-size:13px;margin:0 0 32px 0;">Prazo de revisão até {{expiresAt}} — depois disso a oferta expira sozinha.</p>
          </td>
        </tr>

        <tr>
          <td style="background:#f9f9f9;padding:24px 40px;text-align:center;border-top:1px solid #eee;">
            <p style="color:#ccc;font-size:11px;margin:0;">Stockzy © {{year}}</p>
          </td>
        </tr>

      </table>
    </td></tr>
  </table>
</body>
</html>

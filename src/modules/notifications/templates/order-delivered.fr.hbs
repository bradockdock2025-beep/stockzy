<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Commande Livrée</title>
</head>
<body style="margin:0;padding:0;background:#f5f5f5;font-family:Arial,Helvetica,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background:#f5f5f5;padding:40px 0;">
    <tr><td align="center">
      <table width="600" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:8px;overflow:hidden;max-width:600px;width:100%;">
        <tr>
          <td style="background:#000000;padding:24px 40px;text-align:center;">
            <img src="https://lpowjerychcsqrtodvoh.supabase.co/storage/v1/object/public/email-assets/logo.png" alt="Stockzy" width="160" style="display:block;margin:0 auto;max-width:160px;" />
          </td>
        </tr>
        <tr>
          <td style="padding:40px;">
            <p style="color:#333;font-size:16px;margin:0 0 8px 0;">Bonjour, {{firstName}},</p>
            <p style="color:#333;font-size:16px;margin:0 0 32px 0;">Votre commande a été livrée.</p>
            <div style="background:#f9f9f9;border-radius:6px;padding:20px;margin-bottom:32px;">
              <table width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="color:#999;font-size:12px;text-transform:uppercase;letter-spacing:1px;padding-bottom:4px;">Commande</td>
                  <td style="color:#000;font-size:14px;font-weight:bold;text-align:right;">{{orderNumber}}</td>
                </tr>
              </table>
            </div>
            <a href="{{reviewUrl}}" style="display:inline-block;background:#000;color:#fff;text-decoration:none;padding:14px 32px;border-radius:4px;font-size:13px;letter-spacing:2px;text-transform:uppercase;">Laisser un avis</a>
          </td>
        </tr>
        <tr>
          <td style="background:#f9f9f9;padding:24px 40px;text-align:center;border-top:1px solid #eee;">
            <p style="color:#999;font-size:12px;margin:0 0 4px 0;">Questions ? <a href="mailto:{{supportEmail}}" style="color:#000;">{{supportEmail}}</a></p>
            <p style="color:#ccc;font-size:11px;margin:0;">Stockzy © {{year}}</p>
          </td>
        </tr>
      </table>
    </td></tr>
  </table>
</body>
</html>

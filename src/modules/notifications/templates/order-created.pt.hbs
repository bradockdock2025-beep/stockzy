<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Pedido Confirmado</title>
</head>
<body style="margin:0;padding:0;background:#f5f5f5;font-family:Arial,Helvetica,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background:#f5f5f5;padding:40px 0;">
    <tr><td align="center">
      <table width="600" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:8px;overflow:hidden;max-width:600px;width:100%;">

        <!-- Header -->
        <tr>
          <td style="background:#000000;padding:24px 40px;text-align:center;">
            <img src="https://lpowjerychcsqrtodvoh.supabase.co/storage/v1/object/public/email-assets/logo.png" alt="Stockzy" width="160" style="display:block;margin:0 auto;max-width:160px;" />
          </td>
        </tr>

        <!-- Body -->
        <tr>
          <td style="padding:40px 40px 0 40px;">
            <p style="color:#333;font-size:16px;margin:0 0 8px 0;">Olá, {{firstName}},</p>
            <p style="color:#333;font-size:16px;margin:0 0 32px 0;">Recebemos o seu pedido e estamos a processá-lo.</p>

            <!-- Order number -->
            <div style="background:#f9f9f9;border-radius:6px;padding:20px;margin-bottom:24px;">
              <p style="margin:0 0 4px 0;color:#999;font-size:11px;text-transform:uppercase;letter-spacing:2px;">Número do Pedido</p>
              <p style="margin:0;color:#000;font-size:22px;font-weight:bold;">{{orderNumber}}</p>
            </div>

            <!-- Items table -->
            <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:20px;">
              <tr>
                <td style="padding:8px 0;border-bottom:2px solid #000;color:#000;font-size:11px;text-transform:uppercase;letter-spacing:1px;">Produto</td>
                <td style="padding:8px 0;border-bottom:2px solid #000;color:#000;font-size:11px;text-transform:uppercase;letter-spacing:1px;text-align:center;width:50px;">Qtd</td>
                <td style="padding:8px 0;border-bottom:2px solid #000;color:#000;font-size:11px;text-transform:uppercase;letter-spacing:1px;text-align:right;width:90px;">Valor</td>
              </tr>
              {{#each items}}
              <tr>
                <td style="padding:12px 0;border-bottom:1px solid #f0f0f0;color:#333;font-size:14px;">
                  {{this.productName}}
                  {{#if this.attributes}}
                  <br/><span style="color:#999;font-size:12px;">{{this.attributes}}</span>
                  {{/if}}
                </td>
                <td style="padding:12px 0;border-bottom:1px solid #f0f0f0;color:#333;font-size:14px;text-align:center;">{{this.quantity}}</td>
                <td style="padding:12px 0;border-bottom:1px solid #f0f0f0;color:#333;font-size:14px;text-align:right;">€ {{this.unitPrice}}</td>
              </tr>
              {{/each}}
              <tr>
                <td colspan="2" style="padding:8px 0;color:#666;font-size:13px;">Subtotal</td>
                <td style="padding:8px 0;color:#333;font-size:13px;text-align:right;">€ {{subtotal}}</td>
              </tr>
              <tr>
                <td colspan="2" style="padding:4px 0;color:#666;font-size:13px;">Frete</td>
                <td style="padding:4px 0;color:#333;font-size:13px;text-align:right;">€ {{shippingAmount}}</td>
              </tr>
              <tr>
                <td colspan="2" style="padding:12px 0;border-top:2px solid #000;color:#000;font-size:16px;font-weight:bold;">Total</td>
                <td style="padding:12px 0;border-top:2px solid #000;color:#000;font-size:16px;font-weight:bold;text-align:right;">€ {{totalAmount}}</td>
              </tr>
            </table>

            <!-- Shipping address -->
            {{#if shippingStreet}}
            <div style="background:#fff8e1;border-radius:6px;padding:20px;margin-bottom:24px;border-left:4px solid #f59e0b;">
              <p style="margin:0 0 8px 0;color:#999;font-size:11px;text-transform:uppercase;letter-spacing:1px;">Endereço de Entrega</p>
              <p style="margin:0;color:#000;font-size:14px;line-height:1.6;">
                {{shippingStreet}}<br/>
                {{shippingCity}}{{#if shippingState}}, {{shippingState}}{{/if}}{{#if shippingZipcode}} — {{shippingZipcode}}{{/if}}<br/>
                {{shippingCountry}}
              </p>
            </div>
            {{/if}}

          </td>
        </tr>

        <!-- CTAs -->
        <tr>
          <td style="padding:0 40px 40px 40px;">
            <a href="{{receiptUrl}}" style="display:inline-block;background:#000;color:#fff;text-decoration:none;padding:14px 32px;border-radius:4px;font-size:13px;letter-spacing:2px;text-transform:uppercase;">Baixar Recibo PDF</a>
          </td>
        </tr>

        <!-- Footer -->
        <tr>
          <td style="background:#f9f9f9;padding:24px 40px;text-align:center;border-top:1px solid #eee;">
            <p style="color:#999;font-size:12px;margin:0 0 4px 0;">Dúvidas? <a href="mailto:{{supportEmail}}" style="color:#000;">{{supportEmail}}</a></p>
            <p style="color:#ccc;font-size:11px;margin:0;">Stockzy © {{year}}</p>
          </td>
        </tr>

      </table>
    </td></tr>
  </table>
</body>
</html>
